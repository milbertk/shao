# shao (Go backend) — environment variables for the server.
# shao reads them from the process environment: export them in your service
# (systemd Environment=, Docker env, or `set -a; . ./.env; set +a` before starting).

# Port of the API (default 8081).
PORT=8081

# Extra allowed browser origins, comma separated (the local/LAN ones are already allowed).
# MUST include the real addresses of p3 and the store, or the browser blocks every call.
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://store.yourdomain.com
# Dev only: accept any origin.
# ALLOW_ANY_ORIGIN=1

# AI assistant (Aleph).
ANTHROPIC_API_KEY=

# Key that encrypts the companies' SMTP passwords (tbl_company_smtp).
# Set it ONCE and never change it: if it changes, saved SMTP passwords cannot be read
# and every company must type its SMTP password again. (Falls back to JWT_SECRET.)
SMTP_ENCRYPTION_KEY=

# Database: connection.json (keys shaohost, shaoport, shaouser, shaopass, shaodatabase).
